# rx512 tupfile

# Compile and run all tests
: foreach test/*.v |> iverilog %f -o build/test/current -Isrc/ && cd build/test/ && ./current && rm current |> build/%fcd

# Compile rx512 for the Go Board
: src/rx512.v |> yosys -p "synth_ice40 -json %o" %f |> build/rx512.json
: build/rx512.json |> nextpnr-ice40 --hx1k --package vq100 --json %f --pcf Go_Board_Constraints.pcf --asc %o |> build/rx512.asc
: build/rx512.asc |> icepack %f %o |> build/rx512.bin
